{
  "name": "ayni-connectors",
  "private": true,
  "license": "Apache-2.0",
  "description": "Providers of the Ayni Feature Profiles (Files 1.0, Calendar 1.0) over MCP: the contracts as code, a kit for connectors, a conformance kit and the connectors themselves",
  "repository": {
    "type": "git",
    "url": "https://github.com/2060-io/ayni-connectors"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "clean": "pnpm -r --filter './packages/*' run clean",
    "check-format": "biome check --unsafe",
    "fix-format": "biome check --write --unsafe",
    "check-types": "pnpm run check-types:build && pnpm run check-types:tests",
    "check-types:build": "pnpm -r --filter './packages/*' exec tsc --noEmit -p tsconfig.build.json",
    "check-types:tests": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "validate": "pnpm check-format && pnpm check-types && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^26.1.1",
    "rimraf": "^6.0.1",
    "tsdown": "^0.16.8",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.16.1"
}
