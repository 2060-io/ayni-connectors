    "descriptions": {
      "files_roots": "List the folders you can work in. Give the start of a path to narrow the list.",
      "files_list": "List what a folder holds, one level only, without the content of its files. With no folder, list the top of the folder you work in.",
      "files_get": "Look at one file or folder: its name, path, type, size, version and dates, without its content.",
      "files_read": "Read a file's content: a text file, or a document of the store's own, as text; any other file as its bytes. Give maxBytes to read only the start of a long text.",
      "files_create": "Create a new file with its content in a folder. Nothing is written if an item of that name is already there, and no folder is created on the way.",
      "files_replace": "Replace the whole content of an existing file. Give the version you read: if the file changed since, nothing is written and the current version comes back.",
      "files_search": "Find files and folders by words in their name, their content, or either. Plain words only: no search operators.",
      "files_create_folder": "Create a folder inside a folder.",
      "files_move": "Move a file or a folder to another folder, rename it, or both. A folder moves with what it holds. The item's reference changes: use the one this answers.",
      "files_trash": "Move a file or a folder to the trash. It can be restored for as long as the store keeps its trash.",
      "files_restore": "Bring an item back from the trash to the folder it left.",
      "files_list_trash": "List the items in the trash that came from the folder you work in.",
      "files_shares": "See who a file or a folder is shared with, and how.",
      "files_share": "Share a file or a folder with people, by their email addresses, or with an audience, as a reader or an editor.",
      "files_unshare": "Stop one share of a file or a folder.",
      "files_versions": "List the former versions of a file, newest first. Read one by giving its version to the read of the file.",
      "files_export": "Read a file converted to another format, one of the formats the file lists.",
      "files_create_team_root": "Create a folder that belongs to the organization, for a team.",
      "files_rename_root": "Rename a team's folder."
    },
