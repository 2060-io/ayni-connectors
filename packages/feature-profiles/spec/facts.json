    ],
    "descriptions": {
      "calendar_calendars": "List the calendars you can use. Give a text to keep those whose title holds it.",
      "calendar_list_events": "List the events of a calendar between two times, each occurrence of a repeating event on its own. Give a text to keep the events whose title, description or place holds it.",
      "calendar_get_event": "Look at one event. Given a repeating event's own reference, it answers the series once, with its rule.",
      "calendar_create_event": "Add an event to a calendar. Give a time zone for an event that repeats.",
      "calendar_update_event": "Change an event you organize. Only the members you give change; an empty description or place removes it. Give the version you read to change nothing if the event changed since.",
      "calendar_cancel_event": "Cancel an event you organize. Those invited are told where the calendar sends invitations. A cancelled event cannot be brought back.",
      "calendar_free_busy": "See when a calendar, and other people, are busy between two times, without anything of their events.",
      "calendar_respond": "Answer an invitation to an event you are invited to: accept, maybe, or decline."
    },
    "arguments": {
