{
  "name": "@ayni.org/ayni-provider-memory",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "main": "./build/index.js",
  "module": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    }
