    "clean": "rimraf ./build",
    "start": "node ./build/cli.js"
  },
  "dependencies": {
    "@ayni.org/ayni-feature-profiles": "workspace:^",
    "@ayni.org/ayni-provider-kit": "workspace:^"
  },
  "devDependencies": {
    "@ayni.org/ayni-conformance": "workspace:^",
    "@modelcontextprotocol/client": "catalog:"
